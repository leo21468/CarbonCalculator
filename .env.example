# FastAPI 服务配置
HOST=0.0.0.0
PORT=8000

# CORS 配置（逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# 碳价配置（元/吨CO2e）
CARBON_PRICE_PER_TON=100.0

# 联网因子搜索（默认关闭；开启后外部结果只作为候选）
ENABLE_EXTERNAL_FACTOR_SEARCH=false
CLIMATIQ_API_KEY=
EXTERNAL_SEARCH_TIMEOUT_SECONDS=8

# 机票图片识别与核算
VISION_MODEL_PROVIDER=sjtu
VISION_MODEL_BASE_URL=https://models.sjtu.edu.cn/api/v1
VISION_MODEL_NAME=qwen
VISION_MODEL_API_KEY=
SJTU_API_KEY=
OPENAI_API_KEY=
VISION_MODEL_TIMEOUT_SECONDS=60
FLIGHT_TICKET_ENABLE_MARKET_PRICE=true
FLIGHT_TICKET_DEFAULT_CARBON_PRICE_PER_TON=100

# 数据库路径（默认项目根目录）
DB_PATH=./carbon_data.db

# ── 企业对接（可选）──
# 碳核算成功后向贵司系统 POST JSON（见 docs/ENTERPRISE_INTEGRATION.md）
# ERP_CARBON_RESULT_WEBHOOK_URL=https://your-erp.example.com/hooks/carbon-result
